# /etc/pi-maintenance.conf - local settings for pi-maintenance.sh.
# install.sh creates the real file (owner root, mode 600) with a random ntfy topic.
# The real file is never committed; only this example is.

# Where Teleporter exports are written, and how many to keep.
BACKUP_DIR=/home/<user>/backups
KEEP_BACKUPS=6

# Tailscale device that receives a copy of each backup (blank = skip).
TAILDROP_TARGET=<pc-tailscale-name>

# ntfy alerts. Anyone who knows the topic can read and post to it,
# so make it long and random, and keep it out of git.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=<long-random-topic>
NTFY_ON_SUCCESS=false

# Upper bound for apt-get and pihole -up (timeout(1) syntax).
STEP_TIMEOUT=45m

# healthchecks.io dead-man switch (blank = skip). Create two checks and paste
# their ping URLs here. Anyone with a ping URL can fake a ping, so keep them
# out of git like the ntfy topic. install.sh asks for these if they're missing.
#   Heartbeat:   pinged every 5 minutes by /etc/cron.d/pi-heartbeat.
#                Suggested check: period 5 minutes, grace 10 minutes.
HC_HEARTBEAT_URL=https://hc-ping.com/<heartbeat-uuid>
#   Maintenance: pi-maintenance.sh pings /start, then success or /fail.
#                Suggested check: cron "0 4 1 * *" in the Pi's time zone, grace 3 hours.
HC_MAINT_URL=https://hc-ping.com/<maintenance-uuid>
# true = attach the last 20 log lines to /fail pings. They can include the
# hostname, backup paths (with your username) and apt output.
HC_SEND_LOG=false
